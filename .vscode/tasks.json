{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "make",
      "windows": {
        "command": "powershell -ExecutionPolicy Bypass -File ./build.ps1"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "test",
      "type": "shell",
      "command": "make test",
      "windows": {
        "command": "powershell -ExecutionPolicy Bypass -File ./tests/run.ps1"
      },
      "group": "test"
    },
    {
      "label": "run gcd.pas",
      "type": "shell",
      "command": "make && ./minipascal samples/gcd.pas",
      "windows": {
        "command": "powershell -ExecutionPolicy Bypass -File ./build.ps1; if ($LASTEXITCODE -eq 0) { .\\minipascal.exe samples\\gcd.pas }"
      }
    },
    {
      "label": "show tokens",
      "type": "shell",
      "command": "make && ./minipascal --tokens samples/gcd.pas",
      "windows": {
        "command": "powershell -ExecutionPolicy Bypass -File ./build.ps1; if ($LASTEXITCODE -eq 0) { .\\minipascal.exe --tokens samples\\gcd.pas }"
      }
    },
    {
      "label": "run broken.pas",
      "type": "shell",
      "command": "make && ./minipascal samples/broken.pas",
      "windows": {
        "command": "powershell -ExecutionPolicy Bypass -File ./build.ps1; if ($LASTEXITCODE -eq 0) { .\\minipascal.exe samples\\broken.pas }"
      }
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "make clean",
      "windows": {
        "command": "Remove-Item -ErrorAction SilentlyContinue minipascal.exe, compiler/parser.tab.c, compiler/parser.tab.h, compiler/lex.yy.c, compiler/*.o"
      }
    }
  ]
}
