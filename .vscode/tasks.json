{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "make",
      "windows": {
        "command": "sh ./build.sh"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "run (type MiniPascal)",
      "type": "shell",
      "command": "make && ./minipascal",
      "windows": {
        "command": "sh ./build.sh && ./minipascal.exe"
      }
    },
    {
      "label": "test",
      "type": "shell",
      "command": "make test",
      "windows": {
        "command": "sh ./tests/run.sh"
      },
      "group": "test"
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "make clean"
    }
  ]
}
