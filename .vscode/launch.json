{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build",
      "type": "node-terminal",
      "request": "launch",
      "command": "sh ./build.sh",
      "linux": {
        "command": "make"
      },
      "osx": {
        "command": "make"
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run gcd.pas",
      "type": "node-terminal",
      "request": "launch",
      "command": "sh ./build.sh && ./minipascal.exe samples/gcd.pas",
      "linux": {
        "command": "make && ./minipascal samples/gcd.pas"
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Show tree (gcd.pas)",
      "type": "node-terminal",
      "request": "launch",
      "command": "sh ./build.sh && ./minipascal.exe --tree samples/gcd.pas",
      "linux": {
        "command": "make && ./minipascal --tree samples/gcd.pas"
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Show tokens (gcd.pas)",
      "type": "node-terminal",
      "request": "launch",
      "command": "sh ./build.sh && ./minipascal.exe --tokens samples/gcd.pas",
      "linux": {
        "command": "make && ./minipascal --tokens samples/gcd.pas"
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run tests",
      "type": "node-terminal",
      "request": "launch",
      "command": "sh ./tests/run.sh",
      "linux": {
        "command": "make test"
      },
      "cwd": "${workspaceFolder}"
    }
  ]
}
