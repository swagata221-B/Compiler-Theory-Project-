{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build",
      "type": "node-terminal",
      "request": "launch",
      "command": "sh ./build.sh",
      "linux": {
        "command": "make"
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run (type MiniPascal)",
      "type": "node-terminal",
      "request": "launch",
      "command": "sh ./build.sh && ./minipascal.exe",
      "linux": {
        "command": "make && ./minipascal"
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run tests",
      "type": "node-terminal",
      "request": "launch",
      "command": "sh ./tests/run.sh",
      "linux": {
        "command": "make test"
      },
      "cwd": "${workspaceFolder}"
    }
  ]
}
